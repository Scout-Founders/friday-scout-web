[Unit]
Description=Scout Gates Sandbox Scheduled Research Runner
After=network-online.target scout-dashboard.service

[Service]
Type=oneshot
User=scout
Group=scout
WorkingDirectory=/opt/friday-scout-web/scout-gates-sandbox
EnvironmentFile=/etc/scout/scout-dashboard.env
ExecStart=/opt/friday-scout-web/.venv/bin/python3 scheduled_research_runner.py --skip-firestore-ingest
Nice=10
IOSchedulingClass=best-effort

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scout-scheduled-research

[Install]
WantedBy=multi-user.target
