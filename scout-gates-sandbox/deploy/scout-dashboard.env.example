# Scout sandbox dashboard environment — copy to /etc/scout/scout-dashboard.env
# Permissions: root:scout, mode 0640. Set secret values on the host only.

# --- Hosted mode (recommended on VPS) ---
SCOUT_HOSTED_MODE=1
SCOUT_MAINTENANCE_MODE=0

# --- Persistent storage (recommended hosted paths) ---
SCOUT_RESEARCH_DB_PATH=/data/scout/scout_memory.db
SCOUT_REPORTS_DIR=/data/scout/reports

# --- SQLite tuning ---
SCOUT_SQLITE_BUSY_TIMEOUT_MS=5000

# --- Secrets (set on host — do not commit) ---
FMP_API_KEY=

# --- Optional overrides ---
# SCOUT_GATE_API_URL=
# SCOUT_REPORTS_ASYNC=true

# --- Do NOT set on hosted v1 ---
# GOOGLE_APPLICATION_CREDENTIALS=
# SCOUT_FIRESTORE_SERVICE_ACCOUNT_JSON=
# SCOUT_FIRESTORE_PROJECT_ID=
# SCOUT_FIRESTORE_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=
